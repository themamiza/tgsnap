async def collect_invite_preview(client: TelegramClient, target: Target, snapshot_dir: Path, scraped_at: datetime, status: LiveStatus) -> dict[str, Any]:
    """Collect only metadata returned by checkChatInvite.

    No join/request APIs, message history, member enumeration, or peek-history
    APIs are used. For ChatInvitePeek, only fields already present in the
    returned chat object are recorded.
    """
    invite = target.invite
    assert invite is not None

    status.set("Found", f"{target.name}" + (f" · ID {target.id}" if target.id is not None else ""))
    status.set("Fallback", "not applicable")
    status.set("Music", "not applicable")
    status.set("Info", "reading invite preview metadata…")

    snapshot = {
        "target_type": target.type.value,
        "source": target.source,
        "invite_preview": True,
        "invite_fingerprint": hashlib.sha256((target.invite_hash or "").encode()).hexdigest()[:12],
        "scraped_at": scraped_at.isoformat(),
        "id": target.id,
        "username": target.username,
        "title": target.name,
        "about": None,
        "verified": False,
        "scam": False,
        "fake": False,
        "participants_count": None,
        "admins_count": None,
        "linked_chat_id": None,
        "slowmode_seconds": None,
        "forum": False,
        "public": None,
        "request_needed": None,
        "preview_participants": [],
        "peek_available": False,
        "peek_expires": None,
        "photos": [],
    }

    if isinstance(invite, types.ChatInvite):
        snapshot.update(
            about=getattr(invite, "about", None),
            verified=bool(getattr(invite, "verified", False)),
            scam=bool(getattr(invite, "scam", False)),
            fake=bool(getattr(invite, "fake", False)),
            participants_count=getattr(invite, "participants_count", None),
            public=bool(getattr(invite, "public", False)),
            request_needed=bool(getattr(invite, "request_needed", False)),
            channel=bool(getattr(invite, "channel", False)),
            broadcast=bool(getattr(invite, "broadcast", False)),
            megagroup=bool(getattr(invite, "megagroup", False)),
            color=getattr(invite, "color", None),
            can_refulfill_subscription=bool(getattr(invite, "can_refulfill_subscription", False)),
            subscription_form_id=getattr(invite, "subscription_form_id", None),
            subscription_pricing=_subscription_pricing(getattr(invite, "subscription_pricing", None)),
            bot_verification=_bot_verification(getattr(invite, "bot_verification", None)),
            preview_participants=[
                preview_user_data(user)
                for user in (getattr(invite, "participants", None) or [])
                if isinstance(user, types.User)
            ],
        )

        photo = getattr(invite, "photo", None)
        if isinstance(photo, types.Photo):
            status.set("Photos", "downloading invite preview photo…")
            date = getattr(photo, "date", None)
            stamp = date.strftime("%Y%m%dT%H%M%SZ") if date else "unknown-date"
            data = await download_photo(
                client,
                photo,
                snapshot_dir / "photos" / "invite",
                snapshot_dir,
                f"{stamp}_{getattr(photo, 'id', 'unknown')}.jpg",
            )
            if data:
                snapshot["photos"] = [data]
            status.set("Photos", "downloaded" if data else "not available")
        else:
            status.set("Photos", "none found")

    elif isinstance(invite, types.ChatInvitePeek):
        # Telegram exposes a chat object plus a temporary peek expiry. We do
        # not exploit that access to fetch message history or extra metadata.
        chat = invite.chat
        snapshot.update(
            username=getattr(chat, "username", None),
            title=getattr(chat, "title", target.name),
            verified=bool(getattr(chat, "verified", False)),
            scam=bool(getattr(chat, "scam", False)),
            fake=bool(getattr(chat, "fake", False)),
            forum=bool(getattr(chat, "forum", False)),
            public=bool(getattr(chat, "username", None)),
            broadcast=bool(getattr(chat, "broadcast", False)),
            megagroup=bool(getattr(chat, "megagroup", False)),
            peek_available=True,
            peek_expires=datetime.fromtimestamp(invite.expires, timezone.utc).isoformat(),
        )
        photo = getattr(chat, "photo", None)
        photo_id = getattr(photo, "photo_id", None)
        if photo_id:
            snapshot["photos"] = [{"photo_id": photo_id, "date": None, "file": None, "has_video": False}]
            status.set("Photos", "photo metadata found · not fetched")
        else:
            status.set("Photos", "none found")

    status.set("Info", "invite preview collected · no join / no message peek")
    return snapshot


async def collect_snapshot(client: TelegramClient, target: Target, snapshot_dir: Path, scraped_at: datetime, status: LiveStatus) -> dict[str, Any]:
    """Dispatch TARGET to the appropriate snapshot collector."""
    if target.invite is not None and not isinstance(target.invite, types.ChatInviteAlready):
        return await collect_invite_preview(client, target, snapshot_dir, scraped_at, status)
    if target.type is TargetType.USER:
        return await collect_user(client, target, snapshot_dir, scraped_at, status)
    if isinstance(target.entity, types.Channel):
        return await collect_channel(client, target, snapshot_dir, scraped_at, status)
    return await collect_basic_group(client, target, snapshot_dir, scraped_at, status)


##### STORAGE #####

def target_root(target_type: TargetType) -> str:
    return {TargetType.USER: "users", TargetType.GROUP: "groups", TargetType.CHANNEL: "channels"}[target_type]


def prepare_target_dir(output_dir: Path, target: Target) -> Path:
    """Create/rename TARGET folder and return its path."""
    root = output_dir / target_root(target.type)
    root.mkdir(parents=True, exist_ok=True)
    wanted = root / f"{target.storage_key}_{safe_path_part(target.username or target.name)}"

    if wanted.exists():
        return wanted

    old_dirs = sorted(path for path in root.glob(f"{target.storage_key}_*") if path.is_dir())
    if old_dirs:
        old_dirs[0].rename(wanted)
    else:
        wanted.mkdir()
    return wanted


def create_snapshot_dir(target_dir: Path, timestamp: datetime) -> Path:
    """Create a unique UTC timestamped snapshot directory and return it."""
    snapshots = target_dir / "snapshots"
    snapshots.mkdir(exist_ok=True)
    name = timestamp.strftime("%Y-%m-%d_%H-%M-%SZ")
    path, suffix = snapshots / name, 2
    while path.exists():
        path, suffix = snapshots / f"{name}_{suffix}", suffix + 1
    path.mkdir()
    return path


def update_metadata(target_dir: Path, target: Target, snapshot: dict[str, Any], snapshot_dir: Path) -> None:
    """Update target-level metadata while preserving username history."""
    path = target_dir / "metadata.json"
    try:
        old = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    except (OSError, json.JSONDecodeError):
        old = {}

    usernames = list(old.get("known_usernames", []))
    if target.username and target.username not in usernames:
        usernames.append(target.username)

    write_json(
        path,
        {
            "target_type": target.type.value,
            "id": target.id,
            "storage_key": target.storage_key,
            "current_username": target.username,
            "current_name": target.name,
            "known_usernames": usernames,
            "first_seen_at": old.get("first_seen_at", snapshot["scraped_at"]),
            "last_seen_at": snapshot["scraped_at"],
            "latest_snapshot": str(snapshot_dir.relative_to(target_dir)),
        },
    )

##### SCRAPE #####
async def scrape(value: str, output_dir: Path) -> Snapshot:
    """Resolve VALUE, collect and save one Snapshot, then return it."""
    api_id, api_hash, session = load_credentials()
    client = TelegramClient(session, api_id, api_hash)
    status = LiveStatus()
    target: Target | None = None

    # Keep first-login phone/code prompts outside the temporary status block.
    await client.start()

    try:
        target = await resolve_target(client, value, status)
        scraped_at = datetime.now(timezone.utc)
        target_dir = prepare_target_dir(output_dir, target)
        snapshot_dir = create_snapshot_dir(target_dir, scraped_at)
        snapshot = await collect_snapshot(client, target, snapshot_dir, scraped_at, status)

        json_file = snapshot_dir / "snapshot.json"
        write_json(json_file, snapshot)
        update_metadata(target_dir, target, snapshot, snapshot_dir)
        return Snapshot(snapshot, json_file, snapshot_dir)

    finally:
        if target is not None and target.temporary_contact:
            try:
                await client(functions.contacts.DeleteContactsRequest(id=[target.entity]))
            except RPCError as exc:
                status.clear()
                print(f"Warning: could not remove temporary contact: {exc}", file=sys.stderr)
        status.clear()
        await client.disconnect()


##### ARGS #####
def parse_args() -> argparse.Namespace:
    """Parse CLI arguments; exactly one of TARGET or --show is required."""
    parser = argparse.ArgumentParser(description="Take a snapshot of a Telegram user, group, or channel.")
    parser.add_argument("target", nargs="?", help="Username, t.me link, private invite link, phone (+/00...), or Telegram numeric ID")
    parser.add_argument("--show", metavar="SNAPSHOT", type=Path, help="Display a local snapshot without contacting Telegram")
    parser.add_argument("-o", "--output", type=Path, help="Output directory (overrides TGSNAP_OUTPUT_DIR)")
    args = parser.parse_args()
    if (args.target is None) == (args.show is None):
        parser.error("provide exactly one of: TARGET or --show SNAPSHOT")
    return args

##### MAIN #####
async def main() -> int:
    args = parse_args()

    if args.show:
        display_snapshot(read_snapshot(args.show))
        return 0

    try:
        result = await scrape(args.target, args.output or default_output_dir())
    except FloodWaitError as exc:
        print(f"Telegram rate-limited this account. Retry after {exc.seconds} seconds.", file=sys.stderr)
        return 2
    except RPCError as exc:
        print(f"Telegram API error: {exc}", file=sys.stderr)
        return 3

    display_snapshot(result)
    return 0

if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
